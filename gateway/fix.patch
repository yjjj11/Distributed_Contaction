+func handleHistory(w http.ResponseWriter, r *http.Request) {
+	if r.Method != "POST" {
+		writeJSON(w, http.StatusMethodNotAllowed, historyResponse{Success: false, Error: "method not allowed"})
+		return
+	}
+	token := extractToken(r)
+	if token == "" {
+		writeJSON(w, http.StatusUnauthorized, historyResponse{Success: false, Error: "no token"})
+		return
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+
+	vreq := &pb.ValidateTokenRequest{Token: token}
+	vrep, err := authClient.ValidateToken(ctx, vreq)
+	if err != nil || !vrep.Valid {
+		writeJSON(w, http.StatusUnauthorized, historyResponse{Success: false, Error: "invalid token"})
+		return
+	}
+
+	var req historyRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		writeJSON(w, http.StatusBadRequest, historyResponse{Success: false, Error: "invalid request body"})
+		return
+	}
+
+	limit := req.Limit
+	if limit <= 0 {
+		limit = 50
+	}
+
+	dbrep, err := dbClient.GetMessagesBetween(ctx, &pb.GetMessagesBetweenRequest{
+		UserId:   vrep.UserId,
+		FriendId: req.FriendID,
+		Limit:    limit,
+		Offset:   req.Offset,
+	})
+	writeJSON(w, http.StatusOK, dbrep)
+}
